{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LibreDisk",
  "version": "0.0.1",
  "identifier": "net.chambaya.libredisk",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LibreDisk",
        "width": 880,
        "height": 640,
        "minWidth": 620,
        "minHeight": 460
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
