<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Los titulos de seccion, como en el sitio web y en la ventana: pequenos, en mayusculas,
         muy espaciados y del color de acento. Es lo que hace que las tres cosas se reconozcan
         como el mismo programa. -->
    <style name="Seccion">
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/acento</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.13</item>
    </style>

    <!-- El de **la** accion de la pantalla. Hereda del boton del sistema por lo mismo que el
         campo de abajo: un estilo sin padre sustituye al del sistema en vez de añadirse. -->
    <style name="Boton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/boton</item>
        <item name="android:textColor">@color/fondo</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- El de cualquier accion que no sea **la** accion de la pantalla. Es ademas el que el
         tema da por defecto, asi que un `Button` creado en codigo sale ya con la marca puesta.
         Por eso lleva relleno propio: ahi no hay un XML que se lo ponga. -->
    <!-- Lo que destruye algo y no se deshace. Mismo peso que el principal, otro color: la
         diferencia tiene que verse antes de leer el texto. -->
    <style name="BotonPeligro" parent="@style/Boton">
        <item name="android:background">@drawable/boton_peligro</item>
    </style>

    <style name="BotonSuave" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/boton_suave</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Los campos de texto, por lo mismo que los botones: los de las pantallas hechas en
         codigo no tienen un XML donde ponerles el fondo y los colores.

         **El `parent` no es decorativo.** Un estilo sin padre no añade al del sistema: lo
         sustituye entero, y con el se van `focusable` y `focusableInTouchMode`, que es de donde
         un campo de texto saca el poder recibir el cursor. Sin eso, tocar el campo no hacia
         nada: el foco saltaba al boton de arriba y lo que se escribiera no entraba en ninguna
         parte. Dejo sin poder escribir la frase de paso en toda la aplicacion. -->
    <style name="Campo" parent="@android:style/Widget.Material.EditText">
        <item name="android:background">@drawable/campo</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textColorHint">@color/apagado</item>
        <item name="android:textSize">15sp</item>
        <item name="android:padding">14dp</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>
</resources>
