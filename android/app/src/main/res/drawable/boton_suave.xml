<?xml version="1.0" encoding="utf-8"?>
<!-- El secundario: mismo tamano, sin relleno. Lo que distingue «lo que vas a hacer» de «lo que
     tambien puedes hacer» es el color, no el tamano: un boton mas pequeno es mas dificil de
     acertar, y eso no es una jerarquia, es un estorbo. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/linea" />
            <stroke android:width="1dp" android:color="@color/acento" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/linea" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
