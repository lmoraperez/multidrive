<?xml version="1.0" encoding="utf-8"?>
<!-- El fondo del aviso que flota sobre la pantalla.

     Más opaco y con el borde más marcado que una tarjeta, porque este sí se superpone al
     contenido: sobre texto, un panel con el mismo borde de un píxel se lee como parte de lo
     que hay debajo en vez de como algo que está encima. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/linea" />
    <stroke android:width="1dp" android:color="@color/acento" />
    <corners android:radius="12dp" />
</shape>
