<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Para hablar con las nubes. Es el unico permiso que pide la aplicacion, y no hay
         ninguno de almacenamiento: los ficheros se entregan por el Storage Access Framework,
         que no necesita permisos porque es el usuario quien elige. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Sin esto, `JobScheduler` **rechaza** cualquier trabajo que pida una condicion de red,
         que son todos los nuestros: «solo con Wi-Fi no tarificada» es una. Lanza un
         `SecurityException` que, sin mirar lo que devuelve `schedule`, se pierde: la pantalla
         decia «activa, subira cuando se cumplan las condiciones» y en el sistema no habia
         ningun trabajo. Costo una tarde encontrarlo. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Para que la carga automatica siga programada tras reiniciar el telefono, que es justo
         cuando mas falta hace: nadie va a abrir la aplicacion para que suban las fotos de ayer. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Desde Android 11 una aplicacion no ve que otras hay instaladas si no dice cuales le
         interesan. Sin esto, preguntar quien sabe navegar por origenes de documentos devuelve
         una lista vacia aunque el navegador del sistema este ahi, y la pantalla principal
         acabaria mandando a su propio listado creyendo que el telefono no lo trae. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android.document/root" />
        </intent>
    </queries>

    <!-- `roundIcon` apunta al mismo sitio a proposito: un icono adaptativo ya se recorta con la
         mascara que pida cada lanzador, redonda incluida, asi que una segunda version redonda
         seria el mismo dibujo mantenido dos veces. Se declara igualmente porque hay lanzadores
         que lo piden por su nombre y, si no esta, se quedan con el icono por defecto. -->
    <!-- Sin copia de seguridad. Android la hace por defecto y restaura al reinstalar, y aqui
         eso copia a Google Drive los tokens de todas las cuentas enlazadas, que es justo lo
         que esta aplicacion dice que no sale del telefono. Ademas resucita lo borrado: tras
         reinstalar volvieron todas las cuentas de antes, incluida una quitada a proposito.
         `allowBackup` cubre las versiones viejas; `dataExtractionRules`, Android 12 en
         adelante, donde ademas corta el traspaso directo entre telefonos. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/sin_copia"
        android:icon="@mipmap/ic_launcher"
        android:label="MultiDrive"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/TemaMultiDrive">
        <activity
            android:name=".Principal"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Listado de respaldo, para telefonos sin navegador de documentos del sistema. Solo se
             llega desde la pantalla principal, y solo cuando no hay quien atienda el intent de
             navegar. Lo normal es acabar en la app de Archivos. -->
        <!-- La carga automatica. `BIND_JOB_SERVICE` solo lo tiene el sistema: es lo que impide
             que otra aplicacion arranque nuestras subidas. -->
        <service
            android:name=".Subidor"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- El explorador propio: la via principal para ver y manejar el volumen. Enseña lo
             que solo nosotros sabemos (que una busqueda quedo incompleta, que un fichero es de
             antes de que hubiera fechas) y que un gestor ajeno no puede enseñar. -->
        <activity
            android:name=".Explorador"
            android:exported="false"
            android:label="Archivos" />

        <!-- Configuracion, con la carga automatica. -->
        <activity
            android:name=".Ajustes"
            android:exported="false"
            android:label="Configuración" />

        <activity
            android:name=".Archivos"
            android:exported="false"
            android:label="Ficheros" />

        <!-- Crear el volumen. Se llega desde la pantalla principal cuando hay cuentas
             enlazadas y no hay nada abierto. Sin esto habria que ir a buscar un ordenador
             para empezar, teniendo las cuentas en el propio telefono. -->
        <activity
            android:name=".Crear"
            android:exported="false"
            android:label="Crear volumen" />

        <!-- Abrir un volumen que ya existe en un teléfono donde no hay nada configurado:
             enlazar una cuenta, mirar si trae la maleta y, con la frase, sacar de ella las
             demás cuentas y abrir. Se llega desde la pantalla principal. -->
        <activity
            android:name=".Abrir"
            android:exported="false"
            android:label="Abrir volumen" />

        <!-- Eliminar el volumen de las cuentas. Cuenta lo que hay dentro antes de preguntar, y
             pide escribir el nombre de una cuenta para confirmar: un boton de «si» se pulsa sin
             leer. Se llega desde la pantalla principal, con el volumen cerrado. -->
        <activity
            android:name=".Eliminar"
            android:exported="false"
            android:label="Eliminar volumen" />

        <!-- Recibir lo que se comparte desde otra aplicacion.
             Hace falta aparte del proveedor de documentos, porque son dos mecanismos
             distintos. El proveedor sale en el selector de ficheros del sistema (guardar en,
             la app de Archivos); compartir es una lista de aplicaciones, y ahi un proveedor
             no sale nunca. Y compartir es como la gente mete cosas en una nube desde un
             movil. -->
        <activity
            android:name=".Compartir"
            android:exported="true"
            android:label="MultiDrive"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- El volumen dentro de la app de Archivos y del selector del sistema.
             `exported` tiene que ser true para que otras aplicaciones lo vean, y el permiso
             MANAGE_DOCUMENTS es lo que impide que cualquiera pueda hacerse pasar por el
             sistema al llamarlo: solo el propio Android lo tiene. -->
        <provider
            android:name=".Proveedor"
            android:authorities="${applicationId}.documentos"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>

</manifest>
