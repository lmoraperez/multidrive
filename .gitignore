/target
**/*.rs.bk
.env
*.db
*.db-wal
*.db-shm
/cache
.DS_Store

# Cargo.lock NO se ignora, aunque sea la convencion de las bibliotecas: este workspace
# produce un binario que se distribuye firmado. Sin el fichero fijado, dos compilaciones de
# la misma etiqueta pueden traer versiones distintas de una dependencia transitiva, y en algo
# que maneja claves eso es un agujero de cadena de suministro, no una molestia.

# El instalador de WinFsp se baja al construir, no se guarda en el repositorio: es un
# binario de otro proyecto y su sitio es su propia pagina de publicaciones.
/packaging/windows/terceros/

# Lo genera tauri-build en cada compilacion.
/crates/multidrive-gui/gen/

# Credenciales de la aplicacion que se compilan dentro del binario distribuido. No son de
# nadie en particular, pero un secreto en el historial no se borra: fuera del repositorio.
/packaging/windows/credenciales.conf
