/target
**/*.rs.bk
.env
*.db
*.db-wal
*.db-shm
/cache
.DS_Store

# Cargo.lock NO se ignora, aunque sea la convencion de las bibliotecas: este workspace
# produce un binario que se distribuye firmado. Sin el fichero fijado, dos compilaciones de
# la misma etiqueta pueden traer versiones distintas de una dependencia transitiva, y en algo
# que maneja claves eso es un agujero de cadena de suministro, no una molestia.

# El instalador de WinFsp se baja al construir, no se guarda en el repositorio: es un
# binario de otro proyecto y su sitio es su propia pagina de publicaciones.
/packaging/windows/terceros/

# Lo genera tauri-build en cada compilacion.
/crates/multidrive-gui/gen/

# Credenciales de la aplicacion que se compilan dentro del binario distribuido. No son de
# nadie en particular, pero un secreto en el historial no se borra: fuera del repositorio.
/packaging/windows/credenciales.conf

# Android: lo que genera Gradle y lo que deja el guion de compilacion.
#
# `jniLibs` no va al repositorio porque es la salida de cargo copiada: tenerla versionada
# significaria que alguien puede clonar y compilar un APK con un nucleo que no corresponde a
# las fuentes que tiene delante.
/android/build/
/android/app/build/
/android/.gradle/
/android/local.properties
/android/app/src/main/jniLibs/
/android/app/libs/

# La clave con la que se firman los APK, y su contrasena. Fuera del repositorio las dos.
#
# Quien tenga el almacen puede publicar algo que Android instale **encima** de MultiDrive sin
# avisar a nadie, porque para el sistema seria la misma aplicacion. Y no se puede rotar: el
# dia que se pierda, quien tenga la aplicacion instalada tendra que desinstalarla para poder
# poner la siguiente. Copia de seguridad aparte, y no aqui.
/packaging/android/multidrive.jks
/packaging/android/firma.conf

# Los simbolos nativos de la version que se subio a Play. Se regeneran al compilar y solo
# valen para ese `.so` exacto, asi que versionarlos seria guardar algo que caduca en la
# siguiente compilacion.
/packaging/android/simbolos-nativos.zip

# La carpeta donde Claude deja ficheros de trabajo. No es del proyecto.
/Claude outputs/

# El sitio web. Dejo de versionarse el 24 de octubre de 2026 por decision expresa: este
# repositorio es el software. Los fuentes viven en el equipo desde el que se despliega.
# Se ignora para que un `git add -A` no lo vuelva a meter sin que nadie se entere.
/site/
